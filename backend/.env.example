# ---------------------------------------------------------------
# SecureScan backend configuration
# Copy this file to `.env` (same folder) and fill in the values.
#   Windows (PowerShell):  copy .env.example .env
#   macOS/Linux:           cp .env.example .env
# ---------------------------------------------------------------

# PostgreSQL connection (matches docker-compose.yml – no change needed)
DATABASE_URL="postgresql://securescan:securescan@localhost:5432/securescan?schema=public"

# Secret used to sign JWT login tokens. Any long random string.
JWT_SECRET="replace-with-a-long-random-string"

# ---- AI Assistant (OpenAI) ----
# PASTE YOUR OPENAI API KEY BETWEEN THE QUOTES BELOW.
# Get one at https://platform.openai.com/api-keys (starts with "sk-").
# Leave empty to run in demo mode (canned AI responses, app still works).
OPENAI_API_KEY=""

# Model used for the assistant (inexpensive default). You can change it.
OPENAI_MODEL="gpt-4o-mini"

# Only change if you use an OpenAI-compatible proxy.
OPENAI_BASE_URL="https://api.openai.com/v1"

# Port the backend listens on
PORT=3000
